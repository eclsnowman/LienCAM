+     * Fillet ONE edge with a radius that varies linearly with arc length:
+     * r(s) = startRadius + (endRadius - startRadius) * s / L, s = 0 at the edge
+     * end that coincides with `start`. Throws (and builds nothing) when the
+     * edge's tangent contour has more than one edge, is closed, or `start` is
+     * not exactly one of its ends. WO-3240 feasibility binding.
+     */
+    filletLinearWithHistory(
+        solid: ShapeHandle,
+        edge: ShapeHandle,
+        startRadius: number,
+        endRadius: number,
+        start: { x: number; y: number; z: number },
+        inputFaceHashes: number[],
+        hashUpperBound: number,
+    ): EvolutionData {
+        return wrap("filletLinearWithHistory", () =>
+            this.#withI32(inputFaceHashes, (hashes) =>
+                this.#extractEvolution(
+                    this.#raw.filletLinearWithHistory(solid, edge, startRadius, endRadius, start.x, start.y, start.z, hashes, hashUpperBound),
+                ),
+            ),
+        );
+    }
+
+    /** WO-3240 vendor feasibility facts; see the layout comment in the codegen spec. */
+    filletContourFacts(solid: ShapeHandle, edge: ShapeHandle, startRadius: number, endRadius: number): number[] {
+        return wrap("filletContourFacts", () => {
+            const vec = this.#raw.filletContourFacts(solid, edge, startRadius, endRadius);
+            try {
+                const out: number[] = [];
+                for (let i = 0; i < vec.size(); i++) out.push(vec.get(i));
+                return out;
+            } finally {
+                vec.delete();
+            }
+        });
