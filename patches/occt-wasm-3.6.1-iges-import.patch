+        params: &[FacadeParam::ShapeId("id"), FacadeParam::Bool("brepMode")],
+        occt_class: "",
+        ctor_args: "",
+        setup_code: "\
+const auto& shape = get(id);
+
+IGESControl_Writer writer(\"MM\", brepMode ? 1 : 0);
+if (!writer.AddShape(shape)) {
+    throw std::runtime_error(\"exportIges: transfer failed\");
+}
+writer.ComputeModel();
+
+const char* tmpPath = \"/tmp/export.iges\";
+if (!writer.Write(tmpPath)) {
+    throw std::runtime_error(\"exportIges: write failed\");
+}
+
+FILE* f = fopen(tmpPath, \"r\");
+if (!f) {
+    throw std::runtime_error(\"exportIges: cannot read temp file\");
+}
