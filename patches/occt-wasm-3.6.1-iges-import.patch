+fseek(f, 0, SEEK_SET);
+std::string result(size, '\\0');
+size_t got = fread(&result[0], 1, size, f);
+result.resize(got);
+fclose(f);
+
+return result;",
+        includes: &["IGESControl_Writer.hxx"],
+        category: "io",
+        return_type: ReturnType::String,
+    },
